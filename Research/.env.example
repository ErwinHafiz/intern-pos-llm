# Salin ke <nama_agent>/.env lalu isi.
# Endpoint OpenAI-compatible (Azure OpenAI /openai/v1, Alibaba Model Studio, dsb.)
OPENAI_API_KEY=
OPENAI_API_BASE=https://<resource>.openai.azure.com/openai/v1
AZURE_API_VERSION=

# Opsional: Gemini
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=

# Hanya untuk graph_based_agent (cabang RAGFLOW)
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_API_KEY=
