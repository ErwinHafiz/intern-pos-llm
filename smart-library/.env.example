# ===== LLM (Azure OpenAI lewat LiteLLM) =====
# Endpoint "v1" Azure kompatibel OpenAI -> pakai prefix openai/<nama-deployment>
LLM_MODEL=openai/gpt-5.1
LLM_API_BASE=https://<resource>.openai.azure.com/openai/v1
LLM_API_KEY=
LLM_API_VERSION=
# Nama deployment embedding (dipakai RAGFlow & LightRAG agar adil)
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# LLM untuk ekstraksi graph LightRAG (boleh lebih murah dari model chat)
LIGHTRAG_LLM_DEPLOYMENT=gpt-4.1-mini

# ===== RAGFlow (Docker) =====
# http://localhost (lewat nginx :80) atau http://localhost:9380 (API langsung)
RAGFLOW_BASE_URL=http://localhost
# Buat di RAGFlow UI -> avatar -> API
RAGFLOW_API_KEY=
# Persis seperti tampil di RAGFlow UI, mis. text-embedding-3-small@Azure-OpenAI
RAGFLOW_EMBEDDING_MODEL=text-embedding-3-small@azure-model@OpenAI-API-Compatible

# ===== LightRAG Server (1 server per dataset) =====
LIGHTRAG_WORKSPACES=Regulasi Digital ID=http://localhost:9621,Riset RAG=http://localhost:9622
LIGHTRAG_API_KEY=
